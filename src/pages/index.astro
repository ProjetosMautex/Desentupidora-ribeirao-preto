---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmergencySimulator from '../components/EmergencySimulator';
import FaqAccordion from '../components/FaqAccordion';
import {
  COMPANY_INFO,
  SERVICES_DATA,
  NEIGHBORHOODS_RIBEIRAO,
  HOME_FAQS,
} from '../data/seoData';

const waUrl = `https://wa.me/${COMPANY_INFO.whatsappNumber}?text=${encodeURIComponent(
  'Olá! Vim pelo site e gostaria de um orçamento gratuito com a Desentupidora em Ribeirão Preto.'
)}`;
---

<BaseLayout
  title="Desentupidora em Ribeirão Preto 24 Horas | Qualidade, Rapidez e Visita Grátis"
  description="Procurando Desentupidora em Ribeirão Preto SP? Atendimento 24h ultra rápido em 30 min para desentupimento de esgoto, vaso sanitário, ralo, limpeza de caixa de gordura, hidrossanitária e sistema desagregador hidráulico. Visita Grátis!"
  canonicalPath="/"
  faqSchemaItems={HOME_FAQS}
  preloadHero={true}
>
  <!-- =====================================================================
       1. HERO SECTION (Inspired by reference truck banner + WhatsApp green CTA)
       ===================================================================== -->
  <section class="relative min-h-[560px] lg:min-h-[650px] flex items-center overflow-hidden bg-slate-950">
    <!-- Responsive WebP LCP Hero Image with explicit dimensions -->
    <img
      src="/images/hero-caminhao.webp"
      srcset="/images/hero-caminhao-mobile.webp 640w, /images/hero-caminhao.webp 1280w"
      sizes="100vw"
      width="1280"
      height="720"
      alt="Caminhão de Hidrojateamento e Auto Vácuo da Desentupidora em Ribeirão Preto 24 Horas"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-45"
      fetchpriority="high"
      decoding="async"
    />
    <!-- Multi-layer Dark Gradient Overlay for high text contrast -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/85 to-slate-900/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/40"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-24 w-full">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8 space-y-6">
          <!-- Golden Yellow Overline -->
          <div class="inline-flex items-center gap-2 bg-amber-400/15 border border-amber-400/40 rounded-full px-4 py-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span class="text-amber-400 text-xs sm:text-sm font-extrabold uppercase tracking-wider">
              SOLUÇÕES EM SANEAMENTO PARA SUA TRANQUILIDADE EM RIBEIRÃO PRETO
            </span>
          </div>

          <!-- Main H1 Heading -->
          <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-extrabold text-white tracking-tight leading-[1.12]">
            Contrate uma empresa limpadora e <span class="text-amber-400">desentupidora em Ribeirão Preto</span> de qualidade
          </h1>

          <!-- Persuasive Subtitle -->
          <p class="text-base sm:text-lg lg:text-xl text-slate-200 max-w-2xl leading-relaxed font-normal">
            Descubra como podemos cuidar da sua residência, condomínio ou empresa com eficiência, pontualidade e segurança. Atendimento de <strong>desentupidora 24 horas em Ribeirão Preto SP</strong> sem quebrar pisos e com visita técnica 100% gratuita.
          </p>

          <!-- Primary CTA Buttons -->
          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm sm:text-base px-8 py-4 rounded-full shadow-xl shadow-emerald-500/30 transition-colors uppercase tracking-wide"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z"/>
              </svg>
              <span>Fale Conosco no WhatsApp</span>
            </a>

            <a
              href="#orcamento"
              class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/25 font-bold text-sm sm:text-base px-7 py-4 rounded-full transition-colors"
            >
              <span>Simular Orçamento Grátis</span>
            </a>
          </div>

          <!-- Quick Trust Badges Strip -->
          <div class="pt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 border-t border-white/15">
            <div class="bg-slate-900/70 backdrop-blur-sm border border-white/10 rounded-xl p-3">
              <div class="text-amber-400 font-black text-lg sm:text-xl">30 Min</div>
              <div class="text-xs text-slate-200">Chegada Ultra Rápida em RP</div>
            </div>
            <div class="bg-slate-900/70 backdrop-blur-sm border border-white/10 rounded-xl p-3">
              <div class="text-emerald-400 font-black text-lg sm:text-xl">R$ 0,00</div>
              <div class="text-xs text-slate-200">Visita e Orçamento no Local</div>
            </div>
            <div class="bg-slate-900/70 backdrop-blur-sm border border-white/10 rounded-xl p-3">
              <div class="text-amber-400 font-black text-lg sm:text-xl">100% Limpo</div>
              <div class="text-xs text-slate-200">Sem Quebrar Pisos ou Paredes</div>
            </div>
            <div class="bg-slate-900/70 backdrop-blur-sm border border-white/10 rounded-xl p-3">
              <div class="text-emerald-400 font-black text-lg sm:text-xl">Plantão 24h</div>
              <div class="text-xs text-slate-200">Domingos e Feriados</div>
            </div>
          </div>
        </div>

        <!-- Right Floating Dispatch Status Card (Desktop) -->
        <div class="hidden lg:block lg:col-span-4">
          <div class="bg-slate-900/85 backdrop-blur-md border border-slate-700/80 rounded-3xl p-6 shadow-2xl space-y-5">
            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
              <div>
                <span class="text-[11px] font-extrabold uppercase tracking-widest text-amber-400 block">
                  RADAR OPERACIONAL AO VIVO
                </span>
                <h2 class="text-lg font-extrabold text-white">
                  Unidades em Ribeirão Preto
                </h2>
              </div>
              <span class="inline-flex items-center gap-1.5 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold px-3 py-1 rounded-full">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                Ativo 24h
              </span>
            </div>

            <div class="space-y-3 text-xs">
              <div class="flex items-center justify-between bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                <div>
                  <div class="font-bold text-white">Unidade Zona Sul & Fiúsa</div>
                  <div class="text-slate-300">Ribeirânia, Nova Aliança, Bonfim Paulista</div>
                </div>
                <span class="text-emerald-400 font-extrabold">~20 min</span>
              </div>
              <div class="flex items-center justify-between bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                <div>
                  <div class="font-bold text-white">Base Anhanguera & Zona Leste</div>
                  <div class="text-slate-300">Castelo Branco, Jd. Paulista, Novo Mundo</div>
                </div>
                <span class="text-emerald-400 font-extrabold">~15 min</span>
              </div>
              <div class="flex items-center justify-between bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                <div>
                  <div class="font-bold text-white">Unidade Centro & Zona Norte</div>
                  <div class="text-slate-300">Centro, Vila Tibério, Campos Elíseos, Ipiranga</div>
                </div>
                <span class="text-emerald-400 font-extrabold">~25 min</span>
              </div>
            </div>

            <div class="pt-1">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm py-3.5 px-4 rounded-xl transition-colors"
              >
                <span>💬 Chamar Plantão 24h no WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       2. ABOUT & AUTHORITY SECTION
       ===================================================================== -->
  <section id="sobre" class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left Column: Copy + 3 Yellow Circular Icon Features -->
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-indigo-950 block">
            SEU PARCEIRO EM SOLUÇÕES DE SANEAMENTO EM RIBEIRÃO PRETO
          </span>

          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Excelência em Limpeza, Hidrossanitária e Desentupimentos desde {COMPANY_INFO.foundedYear}
          </h2>

          <p class="text-slate-700 text-base leading-relaxed">
            A <strong>HidroRibeirão Limpeza e Desentupimentos</strong> é uma <strong>empresa de desentupimento em Ribeirão Preto</strong> dedicada a fornecer serviços de limpeza técnica, engenharia <strong>hidrossanitária em Ribeirão Preto</strong> e desobstrução de alta performance em toda a região metropolitana. Nossa missão é oferecer soluções eficientes, rápidas e sustentáveis, sempre priorizando a satisfação de nossos clientes e o respeito ao <strong>saneamento básico em Ribeirão Preto</strong>.
          </p>

          <!-- 3 Feature Rows with Golden-Yellow Circular Icons -->
          <div class="space-y-6 pt-2">
            <!-- Feature 1 -->
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-full bg-amber-400 flex items-center justify-center shrink-0 shadow-md shadow-amber-400/30">
                <svg class="w-7 h-7 stroke-slate-950" fill="none" viewBox="0 0 24 24" stroke-width="2.2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-extrabold text-slate-900">
                  Compromisso com a Qualidade e Sistema Desagregador Hidráulico
                </h3>
                <p class="text-sm text-slate-700 leading-relaxed mt-1">
                  Equipe treinada e certificada, utilizando equipamentos modernos como o <strong>sistema desagregador hidráulico em Ribeirão Preto</strong> e sondas rotativas para desentupir sem quebrar pisos, garantindo excelência e segurança.
                </p>
              </div>
            </div>

            <!-- Feature 2 -->
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-full bg-amber-400 flex items-center justify-center shrink-0 shadow-md shadow-amber-400/30">
                <svg class="w-7 h-7 stroke-slate-950" fill="none" viewBox="0 0 24 24" stroke-width="2.2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-extrabold text-slate-900">
                  Transparência, Confiança e Preço Justo (Visita Grátis)
                </h3>
                <p class="text-sm text-slate-700 leading-relaxed mt-1">
                  Mantemos uma comunicação aberta e transparente com nossos clientes: avaliamos o problema sem custo no local, sendo a escolha ideal para quem busca uma <strong>desentupidora barata em Ribeirão Preto</strong> com garantia por escrito.
                </p>
              </div>
            </div>

            <!-- Feature 3 -->
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-full bg-amber-400 flex items-center justify-center shrink-0 shadow-md shadow-amber-400/30">
                <svg class="w-7 h-7 stroke-slate-950" fill="none" viewBox="0 0 24 24" stroke-width="2.2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-extrabold text-slate-900">
                  Sustentabilidade e Responsabilidade Ambiental
                </h3>
                <p class="text-sm text-slate-700 leading-relaxed mt-1">
                  Seguimos as mais rígidas normas de segurança, documentação e legislações vigentes, realizando o encaminhamento correto de efluentes para <strong>estação de tratamento de esgoto de Ribeirão Preto</strong>.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Experience Badge + Operational Showcase Frame -->
        <div class="lg:col-span-6 relative pt-8 sm:pt-10">
          <div class="absolute top-0 left-0 z-20 bg-indigo-950 text-white px-8 py-6 rounded-tr-[36px] rounded-bl-2xl shadow-xl border-b-4 border-amber-400">
            <div class="text-4xl sm:text-5xl font-black tracking-tight text-white text-center">
              {COMPANY_INFO.yearsExperience}
            </div>
            <div class="text-[11px] sm:text-xs font-extrabold uppercase tracking-widest text-amber-400 mt-1 text-center">
              ANOS DE EXPERIÊNCIA
            </div>
          </div>

          <!-- Main Media Frame with responsive WebP and explicit width/height -->
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-slate-200 bg-slate-900 ml-0 sm:ml-6">
            <img
              src="/images/equipe-tecnica.webp"
              srcset="/images/equipe-tecnica-mobile.webp 480w, /images/equipe-tecnica.webp 720w"
              sizes="(max-width: 768px) 95vw, 550px"
              width="720"
              height="540"
              alt="Equipe técnica da Desentupidora em Ribeirão Preto operando equipamento de inspeção e sistema desagregador hidráulico"
              class="w-full h-[380px] sm:h-[440px] object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="bg-gradient-to-t from-slate-950 via-slate-950/90 to-transparent p-4 sm:p-5 text-white">
              <div class="flex items-center justify-between text-xs font-semibold mb-2">
                <span class="inline-flex items-center gap-2 text-emerald-400">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  Tecnologia Sem Quebra de Pisos • Ribeirão Preto SP
                </span>
                <span class="text-slate-200 font-mono">100% Garantido</span>
              </div>
              <div class="w-full bg-white/20 h-1.5 rounded-full overflow-hidden">
                <div class="bg-amber-400 w-3/4 h-full rounded-full"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       3. DIAGONAL SPLIT BANNER: VISION, MISSION & REGIONAL COMMITMENT
       ===================================================================== -->
  <section class="bg-slate-100 overflow-hidden border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 items-stretch">
        <div class="lg:col-span-5 py-14 lg:py-20 pr-0 lg:pr-10 flex flex-col justify-center">
          <span class="text-xs font-extrabold uppercase tracking-widest text-indigo-950 mb-2">
            EXCELÊNCIA EM SANEAMENTO DESDE {COMPANY_INFO.foundedYear}
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 leading-tight">
            Seu Parceiro em Limpeza e Desentupimentos em Ribeirão Preto e Região
          </h2>
          <p class="text-sm sm:text-base text-slate-700 mt-4 leading-relaxed">
            Atendemos com frota própria em todos os bairros de <strong>Ribeirão Preto SP</strong> (Zona Sul, Centro, Eixo Anhanguera, Zona Leste e Zona Norte), além de Bonfim Paulista, Cravinhos, Sertãozinho e Jardinópolis.
          </p>
        </div>

        <div class="lg:col-span-7 relative flex items-stretch">
          <div
            class="hidden lg:block w-8 bg-amber-400 shrink-0 transform -skew-x-12 translate-x-4 z-10"
            aria-hidden="true"
          ></div>

          <div class="bg-indigo-950 text-white flex-1 py-14 lg:py-20 px-6 sm:px-10 lg:pl-16 lg:pr-12 rounded-3xl lg:rounded-none grid sm:grid-cols-2 gap-8 items-center relative">
            <div class="space-y-3">
              <div class="w-10 h-1 bg-amber-400 rounded-full"></div>
              <h3 class="text-xl sm:text-2xl font-extrabold text-white">
                Nossa Visão
              </h3>
              <p class="text-sm text-slate-200 leading-relaxed">
                Ser reconhecida como a principal <strong>desentupidora em Ribeirão Preto</strong> pela excelência, rapidez no atendimento 24 horas, qualidade técnica e confiabilidade dos nossos serviços de saneamento.
              </p>
            </div>

            <div class="space-y-3">
              <div class="w-10 h-1 bg-amber-400 rounded-full"></div>
              <h3 class="text-xl sm:text-2xl font-extrabold text-white">
                Nossa Missão
              </h3>
              <p class="text-sm text-slate-200 leading-relaxed">
                Prestar serviços eficientes de desentupimento, <strong>hidrossanitária</strong> e <strong>tratamento de esgoto em Ribeirão Preto</strong>, promovendo saúde pública, preço justo e valor socioambiental.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       4. SERVICES SILO SECTION
       ===================================================================== -->
  <section id="servicos" class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
        <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-blue-950 bg-blue-50 border border-blue-200 px-3.5 py-1.5 rounded-full">
          PORTFÓLIO COMPLETO DE DESENTUPIMENTO 24 HORAS
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          Serviços de Desentupidora em Ribeirão Preto SP
        </h2>
        <p class="text-base sm:text-lg text-slate-700">
          Atendemos residências, condomínios, comércios, restaurantes e indústrias com equipamentos específicos para cada tubulação. Clique no serviço desejado para ver detalhes técnicos ou peça seu orçamento imediato:
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {SERVICES_DATA.map((service) => (
          <article class="group bg-slate-50 hover:bg-white rounded-3xl border border-slate-200/90 hover:border-blue-900/40 p-7 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-5">
                <span class="text-xs font-extrabold uppercase tracking-wider bg-amber-400 text-slate-950 px-3 py-1 rounded-full">
                  {service.badge}
                </span>
                <span class="text-xs font-extrabold text-emerald-950 bg-emerald-100 border border-emerald-300 px-2.5 py-1 rounded-full">
                  Visita Grátis
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 group-hover:text-blue-900 transition-colors leading-snug">
                <a href={`/servicos/${service.slug}`}>
                  {service.title}
                </a>
              </h3>

              <p class="text-sm text-slate-700 mt-3 leading-relaxed">
                {service.description}
              </p>

              <ul class="mt-5 space-y-2 border-t border-slate-200/70 pt-4">
                {service.benefits.slice(0, 3).map((benefit) => (
                  <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-800">
                    <span class="text-emerald-800 font-black mt-0.5">✓</span>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-7 pt-4 border-t border-slate-200/60 flex items-center justify-between gap-3">
              <a
                href={`/servicos/${service.slug}`}
                class="text-xs sm:text-sm font-extrabold text-blue-950 hover:text-blue-800 inline-flex items-center gap-1"
              >
                <span>Ver detalhes</span>
                <span>→</span>
              </a>

              <a
                href={`https://wa.me/${COMPANY_INFO.whatsappNumber}?text=${encodeURIComponent(
                  `Olá! Preciso de orçamento para ${service.title}.`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Orçar ${service.shortTitle} no WhatsApp`}
                class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs px-4 py-2.5 rounded-xl transition-colors"
              >
                Orçar no WhatsApp
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       5. INTERACTIVE EMERGENCY & BUDGET SIMULATOR (React Island)
       ===================================================================== -->
  <section id="orcamento" class="py-16 lg:py-24 bg-slate-100 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <EmergencySimulator client:visible />
    </div>
  </section>

  <!-- =====================================================================
       6. TECHNICAL SEO AUTHORITY SECTION
       ===================================================================== -->
  <section id="saneamento" class="py-20 lg:py-28 bg-slate-950 text-white">
