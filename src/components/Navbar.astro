---
import { COMPANY_INFO, SERVICES_DATA } from '../data/seoData';

const waUrl = `https://wa.me/${COMPANY_INFO.whatsappNumber}?text=${encodeURIComponent(
  'Olá! Preciso de atendimento de Desentupidora em Ribeirão Preto (Orçamento Grátis).'
)}`;
---

<header class="sticky top-0 z-50 w-full bg-white shadow-sm">
  <!-- Top Emergency & Trust Bar -->
  <div class="bg-slate-950 text-slate-200 text-xs border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-4 flex-wrap">
        <span class="inline-flex items-center gap-1.5 font-bold text-amber-400">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          Plantão 24 Horas em Ribeirão Preto SP
        </span>
        <span class="hidden md:inline-flex items-center gap-1 text-slate-200">
          ⏱ Chegada Rápida em até {COMPANY_INFO.responseTime}
        </span>
        <span class="hidden lg:inline-flex items-center gap-1 text-slate-200">
          📍 Centro, Zona Sul, Anhanguera e toda Ribeirão Preto
        </span>
      </div>
      <div class="flex items-center gap-4 ml-auto">
        <span class="hidden sm:inline-flex items-center gap-1 text-emerald-400 font-bold">
          ✓ Visita e Orçamento 100% Grátis
        </span>
        <a
          href={`mailto:${COMPANY_INFO.email}`}
          class="hidden md:inline-flex items-center gap-1 font-semibold text-slate-200 hover:text-amber-400 transition-colors"
        >
          ✉ {COMPANY_INFO.email}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <nav class="bg-white py-3.5" aria-label="Navegação Principal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-950 via-blue-900 to-indigo-900 flex items-center justify-center shadow-md relative shrink-0">
          <span class="text-amber-400 font-extrabold text-xl tracking-tighter">
            HR
          </span>
          <span class="absolute -bottom-1 -right-1 bg-amber-400 text-slate-950 text-[9px] font-black px-1.5 py-0.2 rounded-full">
            24H
          </span>
        </div>
        <div>
          <span class="block text-lg sm:text-xl font-extrabold tracking-tight text-slate-900 leading-none">
            Hidro<span class="text-blue-900">Ribeirão</span>
          </span>
          <span class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mt-0.5">
            Desentupidora & Saneamento RP
          </span>
        </div>
      </a>

      <!-- Desktop Links -->
      <div class="hidden lg:flex items-center gap-7 text-sm font-bold text-slate-800">
        <a href="/" class="hover:text-blue-900 transition-colors">
          Início
        </a>
        <a href="/sobre-nos" class="hover:text-blue-900 transition-colors">
          Quem Somos
        </a>

        <!-- Dropdown de Serviços (CSS hover + focus-within, 0 JS overhead) -->
        <div class="relative group">
          <button
            type="button"
            class="inline-flex items-center gap-1 hover:text-blue-900 transition-colors py-2 cursor-pointer"
            aria-haspopup="true"
          >
            <span>Serviços Especializados</span>
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 focus-within:visible focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full pt-2 w-80 z-50">
            <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-2 grid gap-1">
              {SERVICES_DATA.map((service) => (
                <a
                  href={`/servicos/${service.slug}`}
                  class="flex flex-col p-2.5 rounded-xl hover:bg-blue-50 transition-colors"
                >
                  <span class="text-xs font-extrabold text-slate-900">
                    {service.shortTitle}
                  </span>
                  <span class="text-[11px] text-slate-600 line-clamp-1">
                    {service.badge} • Ribeirão Preto SP
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/#saneamento" class="hover:text-blue-900 transition-colors">
          Hidrossanitária & ETE
        </a>
        <a href="/#bairros" class="hover:text-blue-900 transition-colors">
          Bairros Atendidos
        </a>
        <a href="/contato" class="hover:text-blue-900 transition-colors">
          Contato
        </a>
      </div>

      <!-- Desktop CTA Button (High Contrast AAA: text-slate-950 on bg-emerald-400) -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs sm:text-sm px-5 py-2.5 rounded-full shadow-md transition-all"
        >
          <span>💬 FALE NO WHATSAPP</span>
        </a>
      </div>

      <!-- Mobile "MENU" Text Button (Sem as 3 linhas) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden inline-flex items-center justify-center px-4 py-2 rounded-xl bg-blue-950 text-amber-400 font-extrabold text-xs tracking-widest uppercase shadow-sm hover:bg-blue-900 transition-colors cursor-pointer"
        aria-label="Abrir ou fechar menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        MENU
      </button>
    </div>

    <!-- Mobile Drawer -->
    <div
      id="mobile-menu-drawer"
      class="hidden lg:hidden bg-white border-t border-slate-200 px-4 pt-4 pb-6 space-y-4 shadow-xl mt-3"
    >
      <div class="grid gap-2 text-sm font-bold text-slate-900">
        <a href="/" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-100">
          Início (Home)
        </a>
        <a href="/sobre-nos" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-100">
          Quem Somos (Sobre Nós)
        </a>
        <div class="px-3 py-2.5 bg-slate-50 rounded-xl space-y-2 border border-slate-200">
          <span class="text-xs font-extrabold uppercase tracking-wider text-blue-950 block">
            ★ Serviços em Ribeirão Preto
          </span>
          <div class="grid gap-1.5 pl-1">
            {SERVICES_DATA.map((s) => (
              <a
                href={`/servicos/${s.slug}`}
                class="mobile-nav-link text-xs font-semibold text-slate-800 hover:text-blue-900 py-1 border-b border-slate-200/70 last:border-none"
              >
                → {s.title}
              </a>
            ))}
          </div>
        </div>
        <a href="/#saneamento" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-100">
          Hidrossanitária & Tratamento de Esgoto
        </a>
        <a href="/#bairros" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-100">
          Bairros Atendidos em Ribeirão Preto
        </a>
        <a href="/contato" class="mobile-nav-link px-3 py-2 rounded-lg hover:bg-slate-100">
          Página de Contato
        </a>
      </div>

      <div class="pt-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 bg-emerald-500 text-slate-950 font-black text-sm py-3.5 px-4 rounded-xl shadow-md"
        >
          💬 Fale Conosco no WhatsApp 24h
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    var drawer = document.getElementById('mobile-menu-drawer');
    if (!btn || !drawer) return;
    btn.addEventListener('click', function () {
      var isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        drawer.classList.remove('hidden');
        btn.textContent = 'FECHAR';
        btn.setAttribute('aria-expanded', 'true');
      } else {
        drawer.classList.add('hidden');
        btn.textContent = 'MENU';
        btn.setAttribute('aria-expanded', 'false');
      }
    });
    var links = drawer.querySelectorAll('.mobile-nav-link');
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener('click', function () {
        drawer.classList.add('hidden');
        btn.textContent = 'MENU';
        btn.setAttribute('aria-expanded', 'false');
      });
    }
  })();
</script>
